# Option A: Gemini Developer API
GOOGLE_API_KEY=

# Option B: Vertex AI (recommended for deployed Cloud Run)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# Confirm the exact qualifying model name available to your account.
COLONYV_GEMINI_MODEL=gemini-3.5-flash

# Optional local dashboard model adapter
COLONY_MODEL_ID=gemini/gemini-3.5-flash
